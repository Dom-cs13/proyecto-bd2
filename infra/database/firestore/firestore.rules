rules_version = '2';
// firestore.rules · Reglas de seguridad para el Laboratorio Clínico (I3)
// Enfoque de máxima seguridad: "deny-all" desde clientes web no autenticados.
// Todo acceso de lectura y escritura debe ocurrir estrictamente a través del backend Express
// utilizando Firebase Admin SDK con credenciales de cuenta de servicio (IAM con privilegio mínimo).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
