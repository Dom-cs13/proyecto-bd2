# ==============================================================================
# .env.example - Plantilla de variables de entorno para los 4 motores
# REGLA AGENTS.md: No agregar credenciales reales aquí. Copiar a .env para desarrollo local.
# ==============================================================================

PORT=3000
NODE_ENV=development
JWT_SECRET=tu_clave_secreta_jwt_de_ejemplo

# ------------------------------------------------------------------------------
# I1: Hospital General (MongoDB Atlas)
# ------------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# I2: Clínica Odontológica (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=tu_supabase_anon_o_service_key
DATABASE_URL=postgresql://<usuario>:<password>@<host>:5432/<database>

# ------------------------------------------------------------------------------
# I3: Laboratorio Clínico (Firebase Firestore)
# ------------------------------------------------------------------------------
# API Key del proyecto Firebase (Consola Firebase > Configuración del proyecto > General > Tu API Key)
FIREBASE_API_KEY=tu_firebase_api_key_de_ejemplo

# Identificador de tu proyecto en Firebase
FIREBASE_PROJECT_ID=tu-proyecto-firebase

# Credenciales de Service Account para Firebase Admin SDK:
# Opción A: Variables directas del JSON de cuenta de servicio
FIREBASE_CLIENT_EMAIL=tu-service-account@tu-proyecto.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opción B (alternativa): Ruta al archivo JSON descargado de Firebase Console
# FIREBASE_SERVICE_ACCOUNT_PATH=./infra/database/firestore/serviceAccountKey.json

# ------------------------------------------------------------------------------
# I4: Centro Pediátrico (MariaDB local Docker / MariaDB Cloud)
# ------------------------------------------------------------------------------
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=pediatria_user
MARIADB_PASSWORD=pediatria_password
MARIADB_DATABASE=pediatria_db
MARIADB_SSL=false
